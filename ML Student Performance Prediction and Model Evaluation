import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from IPython.display import display, Markdown
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LinearRegression, LogisticRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score, accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, classification_report

df = pd.read_csv("Day18_19_student_habits_performance.csv")

display(Markdown("# Student Performance Prediction and Model Evaluation"))

print("Shape:", df.shape)
display(df.head())
print("\nData Types:")
print(df.dtypes)
print("\nMissing Values:")
print(df.isnull().sum())
print("\nDuplicate Rows:", df.duplicated().sum())
print("\nStatistics:")
display(df.describe())

numerical_cols = df.select_dtypes(include=np.number).columns.tolist()
categorical_cols = df.select_dtypes(include="object").columns.tolist()

print("\nNumerical Variables:")
print(numerical_cols)
print("\nCategorical Variables:")
print(categorical_cols)

for col in categorical_cols:
    print(f"\n{col}")
    display(df[col].value_counts(dropna=False).to_frame("Count"))

df[numerical_cols].hist(figsize=(16, 14), bins=20, edgecolor="black")
plt.tight_layout()
plt.show()

plt.figure(figsize=(9, 6))
sns.histplot(df["exam_score"], bins=20, kde=True)
plt.title("Exam Score Distribution")
plt.show()

plt.figure(figsize=(15, 8))
sns.boxplot(data=df[numerical_cols], orient="h")
plt.title("Numerical Variable Outliers")
plt.show()

outlier_results = []

for col in numerical_cols:
    q1 = df[col].quantile(0.25)
    q3 = df[col].quantile(0.75)
    iqr = q3 - q1
    lower = q1 - 1.5 * iqr
    upper = q3 + 1.5 * iqr
    count = ((df[col] < lower) | (df[col] > upper)).sum()
    outlier_results.append([col, q1, q3, iqr, lower, upper, count])

outlier_table = pd.DataFrame(
    outlier_results,
    columns=["Variable", "Q1", "Q3", "IQR", "Lower Bound", "Upper Bound", "Outlier Count"]
)

display(outlier_table.round(3))

correlation_matrix = df[numerical_cols].corr()

plt.figure(figsize=(12, 9))
sns.heatmap(correlation_matrix, annot=True, fmt=".2f", cmap="coolwarm", center=0)
plt.title("Correlation Matrix")
plt.show()

exam_correlations = correlation_matrix["exam_score"].drop("exam_score").sort_values(key=abs, ascending=False)

print("\nCorrelation with Exam Score:")
display(exam_correlations.to_frame("Correlation"))

for col in exam_correlations.head(5).index:
    plt.figure(figsize=(8, 5))
    sns.scatterplot(data=df, x=col, y="exam_score")
    sns.regplot(data=df, x=col, y="exam_score", scatter=False)
    plt.title(f"{col} vs Exam Score")
    plt.show()

for col in categorical_cols:
    if col != "student_id":
        plt.figure(figsize=(9, 5))
        sns.boxplot(data=df, x=col, y="exam_score")
        plt.title(f"{col} vs Exam Score")
        plt.xticks(rotation=30)
        plt.show()

feature_cols = [col for col in df.columns if col not in ["student_id", "exam_score"]]

numerical_features = [
    col for col in feature_cols
    if col in numerical_cols
]

categorical_features = [
    col for col in feature_cols
    if col in categorical_cols
]

X = df[feature_cols]
y = df["exam_score"]

numeric_transformer = Pipeline([
    ("imputer", SimpleImputer(strategy="median"))
])

categorical_transformer = Pipeline([
    ("imputer", SimpleImputer(strategy="most_frequent")),
    ("encoder", OneHotEncoder(handle_unknown="ignore"))
])

preprocessor = ColumnTransformer([
    ("num", numeric_transformer, numerical_features),
    ("cat", categorical_transformer, categorical_features)
])

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42
)

regression_model = Pipeline([
    ("preprocessor", preprocessor),
    ("model", LinearRegression())
])

regression_model.fit(X_train, y_train)

y_train_pred = regression_model.predict(X_train)
y_test_pred = regression_model.predict(X_test)

train_mae = mean_absolute_error(y_train, y_train_pred)
test_mae = mean_absolute_error(y_test, y_test_pred)

train_mse = mean_squared_error(y_train, y_train_pred)
test_mse = mean_squared_error(y_test, y_test_pred)

train_rmse = np.sqrt(train_mse)
test_rmse = np.sqrt(test_mse)

train_r2 = r2_score(y_train, y_train_pred)
test_r2 = r2_score(y_test, y_test_pred)

regression_results = pd.DataFrame({
    "Metric": ["MAE", "MSE", "RMSE", "R²"],
    "Training": [train_mae, train_mse, train_rmse, train_r2],
    "Testing": [test_mae, test_mse, test_rmse, test_r2]
})

display(regression_results.round(4))

plt.figure(figsize=(8, 6))
plt.scatter(y_test, y_test_pred)

minimum = min(y_test.min(), y_test_pred.min())
maximum = max(y_test.max(), y_test_pred.max())

plt.plot([minimum, maximum], [minimum, maximum], linestyle="--")
plt.xlabel("Actual Exam Score")
plt.ylabel("Predicted Exam Score")
plt.title("Actual vs Predicted Exam Scores")
plt.show()

residuals = y_test - y_test_pred

plt.figure(figsize=(9, 5))
sns.histplot(residuals, bins=20, kde=True)
plt.title("Residual Distribution")
plt.xlabel("Residual")
plt.show()

feature_names = regression_model.named_steps["preprocessor"].get_feature_names_out()
coefficients = regression_model.named_steps["model"].coef_

coefficient_table = pd.DataFrame({
    "Feature": feature_names,
    "Coefficient": coefficients,
    "Absolute Importance": np.abs(coefficients)
}).sort_values("Absolute Importance", ascending=False)

display(coefficient_table.head(15).round(4))

df["pass_fail"] = np.where(df["exam_score"] >= 50, "Pass", "Fail")

print("\nPass/Fail Distribution:")
display(df["pass_fail"].value_counts().to_frame("Count"))

X_class = df[feature_cols]
y_class = df["pass_fail"]

X_train_c, X_test_c, y_train_c, y_test_c = train_test_split(
    X_class,
    y_class,
    test_size=0.20,
    random_state=42,
    stratify=y_class
)

classification_preprocessor = ColumnTransformer([
    (
        "num",
        Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler())
        ]),
        numerical_features
    ),
    (
        "cat",
        Pipeline([
            ("imputer", SimpleImputer(strategy="most_frequent")),
            ("encoder", OneHotEncoder(handle_unknown="ignore"))
        ]),
        categorical_features
    )
])

classification_model = Pipeline([
    ("preprocessor", classification_preprocessor),
    ("model", LogisticRegression(max_iter=2000, random_state=42))
])

classification_model.fit(X_train_c, y_train_c)

y_train_class_pred = classification_model.predict(X_train_c)
y_test_class_pred = classification_model.predict(X_test_c)

train_accuracy = accuracy_score(y_train_c, y_train_class_pred)
test_accuracy = accuracy_score(y_test_c, y_test_class_pred)

train_precision = precision_score(y_train_c, y_train_class_pred, pos_label="Pass", zero_division=0)
test_precision = precision_score(y_test_c, y_test_class_pred, pos_label="Pass", zero_division=0)

train_recall = recall_score(y_train_c, y_train_class_pred, pos_label="Pass", zero_division=0)
test_recall = recall_score(y_test_c, y_test_class_pred, pos_label="Pass", zero_division=0)

train_f1 = f1_score(y_train_c, y_train_class_pred, pos_label="Pass", zero_division=0)
test_f1 = f1_score(y_test_c, y_test_class_pred, pos_label="Pass", zero_division=0)

classification_results = pd.DataFrame({
    "Metric": ["Accuracy", "Precision", "Recall", "F1 Score"],
    "Training": [train_accuracy, train_precision, train_recall, train_f1],
    "Testing": [test_accuracy, test_precision, test_recall, test_f1]
})

display(classification_results.round(4))

cm = confusion_matrix(
    y_test_c,
    y_test_class_pred,
    labels=["Fail", "Pass"]
)

plt.figure(figsize=(7, 5))
sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["Fail", "Pass"],
    yticklabels=["Fail", "Pass"]
)

plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title("Confusion Matrix")
plt.show()

print(classification_report(y_test_c, y_test_class_pred, zero_division=0))

class_feature_names = classification_model.named_steps["preprocessor"].get_feature_names_out()
class_coefficients = classification_model.named_steps["model"].coef_[0]

classification_importance = pd.DataFrame({
    "Feature": class_feature_names,
    "Coefficient": class_coefficients,
    "Absolute Importance": np.abs(class_coefficients)
}).sort_values("Absolute Importance", ascending=False)

display(classification_importance.head(15).round(4))

print("\nTRAINING VS TESTING")
print("Regression Training R²:", round(train_r2, 4))
print("Regression Testing R²:", round(test_r2, 4))
print("Regression Training RMSE:", round(train_rmse, 4))
print("Regression Testing RMSE:", round(test_rmse, 4))
print("Classification Training Accuracy:", round(train_accuracy, 4))
print("Classification Testing Accuracy:", round(test_accuracy, 4))
print("Classification Training F1:", round(train_f1, 4))
print("Classification Testing F1:", round(test_f1, 4))

r2_gap = train_r2 - test_r2
accuracy_gap = train_accuracy - test_accuracy

if r2_gap > 0.15 or accuracy_gap > 0.10:
    conclusion = "The models show signs of possible overfitting."
elif train_r2 < 0.50 and test_r2 < 0.50:
    conclusion = "The regression model shows signs of possible underfitting."
else:
    conclusion = "There is no strong evidence of severe overfitting or underfitting."

print("\nModel Conclusion:", conclusion)

strongest_positive = exam_correlations.idxmax()
strongest_negative = exam_correlations.idxmin()

print("\nFIVE MEANINGFUL INSIGHTS")
print(
    f"1. {strongest_positive} has the strongest positive numerical relationship "
    f"with exam score, with correlation {exam_correlations[strongest_positive]:.3f}."
)

print(
    f"2. {strongest_negative} has the strongest negative numerical relationship "
    f"with exam score, with correlation {exam_correlations[strongest_negative]:.3f}."
)

print(
    f"3. The average exam score is {df['exam_score'].mean():.2f}, while the "
    f"median exam score is {df['exam_score'].median():.2f}."
)

print(
    f"4. {((df['exam_score'] >= 50).mean() * 100):.2f}% of students passed "
    f"the 50-mark threshold."
)

print(
    f"5. The regression model achieved a testing R² of {test_r2:.3f} and "
    f"RMSE of {test_rmse:.3f}, while the classification model achieved "
    f"{test_accuracy:.2%} testing accuracy and an F1-score of {test_f1:.3f}."
)
