# ------------------------------------------------------------
# 7. UNIQUE VALUES
# ------------------------------------------------------------

print("\n" + "=" * 70)
print("UNIQUE VALUES")
print("=" * 70)

for column in df.columns:
    print(
        f"{column}: {df[column].nunique()} unique values"
    )



print("\n" + "=" * 70)
print("DATA SELECTION")
print("=" * 70)

# Select first column
print("First column:")
display(df.iloc[:, [0]].head())

# Select first five columns
print("First five columns:")
display(df.iloc[:, :5].head())



numeric_columns = df.select_dtypes(
    include=np.number
).columns.tolist()

categorical_columns = df.select_dtypes(
    include="object"
).columns.tolist()

print("\n" + "=" * 70)
print("NUMERICAL COLUMNS")
print("=" * 70)
print(numeric_columns)

print("\n" + "=" * 70)
print("CATEGORICAL COLUMNS")
print("=" * 70)
print(categorical_columns)




if len(numeric_columns) > 0:

    main_numeric = numeric_columns[0]

    print("\n" + "=" * 70)
    print("NUMERICAL DATA ANALYSIS")
    print("=" * 70)

    print("Selected numerical column:", main_numeric)

    print(
        "Total:",
        df[main_numeric].sum()
    )

    print(
        "Average:",
        round(df[main_numeric].mean(), 2)
    )

    print(
        "Maximum:",
        df[main_numeric].max()
    )

    print(
        "Minimum:",
        df[main_numeric].min()
    )

    print(
        "Median:",
        df[main_numeric].median()
    )




print("\n" + "=" * 70)
print("FILTERING DATA")
print("=" * 70)

if len(numeric_columns) > 0:

    main_numeric = numeric_columns[0]

    median_value = df[main_numeric].median()

    filtered_data = df[
        df[main_numeric] > median_value
    ]

    print(
        f"Records where {main_numeric} "
        f"is greater than its median:"
    )

    display(filtered_data.head(10))




print("\n" + "=" * 70)
print("MULTIPLE CONDITION FILTERING")
print("=" * 70)

if len(numeric_columns) > 0:

    main_numeric = numeric_columns[0]

    mean_value = df[main_numeric].mean()

    filtered_multiple = df[
        (df[main_numeric] > mean_value) &
        (df[main_numeric].notna())
    ]

    print(
        f"Records where {main_numeric} "
        f"is greater than its mean:"
    )

    display(filtered_multiple.head(10))




print("\n" + "=" * 70)
print("SORTING DATA")
print("=" * 70)

if len(numeric_columns) > 0:

    main_numeric = numeric_columns[0]

    sorted_data = df.sort_values(
        by=main_numeric,
        ascending=False
    )

    print(
        f"Top records sorted by {main_numeric}:"
    )

    display(sorted_data.head(10))


print("\n" + "=" * 70)
print("DATA TRANSFORMATION")
print("=" * 70)

analysis_df = df.copy()


for column in analysis_df.columns:

    if "date" in column.lower():

        analysis_df[column] = pd.to_datetime(
            analysis_df[column],
            errors="coerce"
        )

        print(
            f"{column} converted to datetime."
        )




date_columns = [
    column
    for column in analysis_df.columns
    if pd.api.types.is_datetime64_any_dtype(
        analysis_df[column]
    )
]

if len(date_columns) > 0:

    date_column = date_columns[0]

    analysis_df["Year"] = (
        analysis_df[date_column].dt.year
    )

    analysis_df["Month"] = (
        analysis_df[date_column].dt.month
    )

    analysis_df["Day"] = (
        analysis_df[date_column].dt.day
    )

    print("\nDate transformation completed.")

    display(
        analysis_df[
            [date_column, "Year", "Month", "Day"]
        ].head()
    )




print("\n" + "=" * 70)
print("GROUPBY ANALYSIS")
print("=" * 70)

if len(categorical_columns) > 0:

    group_column = categorical_columns[0]

    group_counts = (
        analysis_df[group_column]
        .value_counts()
    )

    print(
        f"Number of records by {group_column}:"
    )

    display(group_counts)




print("\n" + "=" * 70)
print("GROUPBY AND AGGREGATION")
print("=" * 70)

if (
    len(categorical_columns) > 0
    and len(numeric_columns) > 0
):

    group_column = categorical_columns[0]
    value_column = numeric_columns[0]

    grouped_analysis = (
        analysis_df
        .groupby(group_column)[value_column]
        .agg([
            "count",
            "sum",
            "mean",
            "min",
            "max"
        ])
        .sort_values(
            "sum",
            ascending=False
        )
    )

    print(
        f"{value_column} analysis by {group_column}:"
    )

    display(grouped_analysis)




print("\n" + "=" * 70)
print("TOP PERFORMING GROUPS")
print("=" * 70)

if (
    len(categorical_columns) > 0
    and len(numeric_columns) > 0
):

    display(
        grouped_analysis.head(10)
    )




print("\n" + "=" * 70)
print("AIRLINE ANALYSIS")
print("=" * 70)

if "Airline" in analysis_df.columns:

    airline_analysis = (
        analysis_df["Airline"]
        .value_counts()
    )

    display(airline_analysis)




print("\n" + "=" * 70)
print("LOCATION / AIRPORT ANALYSIS")
print("=" * 70)

location_columns = [
    column
    for column in analysis_df.columns
    if any(
        word in column.lower()
        for word in [
            "airport",
            "city",
            "origin",
            "destination"
        ]
    )
]

print("Location-related columns:")
print(location_columns)

if len(location_columns) > 0:

    location_column = location_columns[0]

    location_analysis = (
        analysis_df[location_column]
        .value_counts()
        .head(10)
    )

    print(
        f"Top values in {location_column}:"
    )

    display(location_analysis)



print("\n" + "=" * 70)
print("FLIGHT STATUS ANALYSIS")
print("=" * 70)

status_columns = [
    column
    for column in analysis_df.columns
    if "status" in column.lower()
]

print("Status columns:", status_columns)

if len(status_columns) > 0:

    status_column = status_columns[0]

    status_analysis = (
        analysis_df[status_column]
        .value_counts()
    )

    display(status_analysis)




print("\n" + "=" * 70)
print("DELAY ANALYSIS")
print("=" * 70)

delay_columns = [
    column
    for column in analysis_df.columns
    if "delay" in column.lower()
]

print("Delay columns:", delay_columns)

if len(delay_columns) > 0:

    delay_column = delay_columns[0]

    print(
        "Average delay:",
        round(
