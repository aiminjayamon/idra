    print(
        "Minimum delay:",
        analysis_df[delay_column].min()
    )

    print("\nTop 10 delayed flights:")

    display(
        analysis_df
        .sort_values(
            delay_column,
            ascending=False
        )
        .head(10)
    )




print("\n" + "=" * 70)
print("MONTH-WISE FLIGHT ANALYSIS")
print("=" * 70)

if "Month" in analysis_df.columns:

    monthly_analysis = (
        analysis_df
        .groupby("Month")
