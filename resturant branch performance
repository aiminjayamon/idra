    "Orders",
    "Revenue",
    "Profit",
    "Marketing_Spend",
    "Staff_Count",
    "Avg_Delivery_Min",
    "Customer_Rating"
]].min())

df["Profit_Margin"] = (df["Profit"] / df["Revenue"]) * 100

df["Order_Conversion_Rate"] = (df["Orders"] / df["Customers"]) * 100

print("\nAverage Profit Margin:")
print(df["Profit_Margin"].mean())

print("\nAverage Order Conversion Rate:")
print(df["Order_Conversion_Rate"].mean())

print("\nTop 10 Records by Revenue:")
print(df.nlargest(10, "Revenue")[[
    "Branch",
    "Region",
    "Store_Type",
    "Customers",
    "Revenue",
    "Profit"
]])

print("\nTop 10 Records by Profit:")
print(df.nlargest(10, "Profit")[[
    "Branch",
    "Region",
    "Store_Type",
    "Customers",
    "Revenue",
    "Profit"
]])

print("\nLowest 10 Records by Profit:")
print(df.nsmallest(10, "Profit")[[
