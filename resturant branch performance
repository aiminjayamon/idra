    "Profit"
]])

print("\nPerformance by Promotion:")
promotion_performance = df.groupby("Promotion", dropna=False).agg({
    "Customers": "mean",
    "Orders": "mean",
    "Revenue": "mean",
    "Profit": "mean",
    "Customer_Rating": "mean"
}).sort_values("Profit", ascending=False)

print(promotion_performance)

print("\nPerformance by Weather:")
weather_performance = df.groupby("Weather").agg({
    "Customers": "mean",
