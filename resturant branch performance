import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv("Day13_Restaurant_Branch_Performance_Dataset.csv")

print("Dataset Shape:", df.shape)
print("\nFirst 5 Rows:")
print(df.head())

print("\nLast 5 Rows:")
print(df.tail())

print("\nDataset Information:")
print(df.info())

print("\nData Types:")
print(df.dtypes)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:", df.duplicated().sum())

print("\nStatistical Summary:")
print(df.describe())

print("\nCategorical Summary:")
print(df.describe(include="object"))

df["Date"] = pd.to_datetime(df["Date"])

print("\nDate Range:")
print(df["Date"].min(), "to", df["Date"].max())

print("\nUnique Branches:")
print(df["Branch"].unique())

print("\nUnique Regions:")
print(df["Region"].unique())

print("\nStore Types:")
print(df["Store_Type"].unique())

print("\nBranch Performance:")
branch_performance = df.groupby("Branch").agg({
    "Customers": "sum",
    "Orders": "sum",
    "Revenue": "sum",
    "Profit": "sum",
    "Marketing_Spend": "sum",
    "Staff_Count": "mean",
    "Avg_Delivery_Min": "mean",
    "Customer_Rating": "mean"
}).sort_values("Profit", ascending=False)

print(branch_performance)

print("\nRegional Performance:")
region_performance = df.groupby("Region").agg({
    "Customers": "sum",
    "Orders": "sum",
    "Revenue": "sum",
    "Profit": "sum",
    "Marketing_Spend": "sum",
    "Avg_Delivery_Min": "mean",
    "Customer_Rating": "mean"
}).sort_values("Profit", ascending=False)

print(region_performance)

print("\nStore Type Performance:")
store_performance = df.groupby("Store_Type").agg({
    "Customers": "sum",
    "Orders": "sum",
    "Revenue": "sum",
    "Profit": "sum",
    "Marketing_Spend": "sum",
    "Staff_Count": "mean",
    "Avg_Delivery_Min": "mean",
    "Customer_Rating": "mean"
}).sort_values("Profit", ascending=False)

print(store_performance)

print("\nAverage Performance:")
print(df[[
    "Customers",
    "Orders",
    "Average_Bill",
    "Revenue",
    "Food_Cost",
    "Operating_Cost",
    "Profit",
