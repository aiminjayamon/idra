import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder, OrdinalEncoder
from sklearn.compose import ColumnTransformer

df = pd.read_csv("Day12_Used_Car_Preprocessing_Dataset.csv")

print("Dataset Shape:", df.shape)
print("\nFirst 5 Rows:")
print(df.head())

print("\nData Types:")
print(df.dtypes)

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:", df.duplicated().sum())

print("\nStatistical Summary:")
print(df.describe())

target = "Resale_Price_Lakh"

X = df.drop(columns=[target, "Car_ID"])
y = df[target]

print("\nFeatures:")
print(X.columns.tolist())

print("\nTarget:", target)

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("\nTraining Data Shape:", X_train.shape)
print("Testing Data Shape:", X_test.shape)

numeric_cols = [
    "Year",
    "Mileage_Km",
    "Engine_CC",
    "Power_BHP",
    "Previous_Owners",
    "Accidents_Reported",
    "Service_Score"
]

nominal_cols = [
    "Brand",
    "Fuel_Type",
    "Transmission",
    "City",
    "Seller_Type"
]

ordinal_cols = ["Condition"]

Q1 = X_train[numeric_cols].quantile(0.25)
Q3 = X_train[numeric_cols].quantile(0.75)
IQR = Q3 - Q1

lower_bounds = Q1 - 1.5 * IQR
upper_bounds = Q3 + 1.5 * IQR

outlier_report = pd.DataFrame({
    "Feature": numeric_cols,
    "Lower_Bound": lower_bounds.values,
    "Upper_Bound": upper_bounds.values,
    "Training_Outliers": [
        ((X_train[col] < lower_bounds[col]) |
         (X_train[col] > upper_bounds[col])).sum()
        for col in numeric_cols
    ]
})

print("\nOutlier Report:")
print(outlier_report)

X_train_clean = X_train.copy()
X_test_clean = X_test.copy()

X_train_clean[numeric_cols] = X_train_clean[numeric_cols].clip(
    lower=lower_bounds,
    upper=upper_bounds,
    axis="columns"
)

X_test_clean[numeric_cols] = X_test_clean[numeric_cols].clip(
    lower=lower_bounds,
    upper=upper_bounds,
    axis="columns"
)

condition_order = [
    ["Poor", "Fair", "Good", "Very Good", "Excellent"]
]

preprocessor = ColumnTransformer(
    transformers=[
        (
            "num",
            StandardScaler(),
            numeric_cols
        ),
        (
            "nominal",
            OneHotEncoder(
                handle_unknown="ignore",
                sparse_output=False
            ),
            nominal_cols
        ),
        (
            "ordinal",
            OrdinalEncoder(
                categories=condition_order,
                handle_unknown="use_encoded_value",
                unknown_value=-1
            ),
            ordinal_cols
        )
    ]
)

X_train_processed = preprocessor.fit_transform(X_train_clean)

X_test_processed = preprocessor.transform(X_test_clean)

feature_names = preprocessor.get_feature_names_out()

X_train_processed = pd.DataFrame(
    X_train_processed,
    columns=feature_names,
    index=X_train.index
)

X_test_processed = pd.DataFrame(
    X_test_processed,
    columns=feature_names,
    index=X_test.index
)

train_output = X_train_processed.copy()
train_output["Resale_Price_Lakh"] = y_train
train_output["Dataset_Split"] = "Train"

test_output = X_test_processed.copy()
test_output["Resale_Price_Lakh"] = y_test
test_output["Dataset_Split"] = "Test"

processed_df = pd.concat(
    [train_output, test_output]
).sort_index()

print("\nProcessed Dataset Shape:", processed_df.shape)

print("\nProcessed Dataset:")
print(processed_df.head())

print("\nMissing Values After Preprocessing:")
print(processed_df.isnull().sum().sum())

print("\nTraining Rows:",
      (processed_df["Dataset_Split"] == "Train").sum())

print("Testing Rows:",
      (processed_df["Dataset_Split"] == "Test").sum())

processed_df.to_csv(
    "Used_Car_Preprocessed_Dataset.csv",
    index=False
)

outlier_report.to_csv(
    "Used_Car_Outlier_Report.csv",
    index=False
)

print("\nPreprocessing completed successfully!")
print("Saved: Used_Car_Preprocessed_Dataset.csv")
print("Saved: Used_Car_Outlier_Report.csv")
